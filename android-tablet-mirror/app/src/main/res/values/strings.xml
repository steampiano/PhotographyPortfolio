    <string name="accessibility_service_label">Tablet Mirror remote control</string>
    <string name="accessibility_service_description">Lets a paired tablet tap, swipe and type on this device while it is being shared. Only active while you are sharing your screen, and only for a viewer that entered the correct PIN.</string>

    <!-- Main -->
    <string name="main_intro">Mirror one tablet onto another over your local network, and drive it from there. Install this app on both tablets and give each one a role.</string>
    <string name="main_share_this_tablet">Share this tablet\'s screen</string>
    <string name="main_share_hint">This tablet is the one being watched and controlled.</string>
    <string name="main_control_other_tablet">Control another tablet</string>
    <string name="main_control_hint">This tablet watches and drives the other one.</string>
    <string name="main_remote_control_heading">Remote control on this tablet</string>
    <string name="main_control_enabled">Enabled. A paired tablet can tap and type here while you are sharing.</string>
    <string name="main_control_disabled">Off. Without it this tablet can still be watched, but not controlled.</string>
    <string name="action_open_accessibility_settings">Turn on remote control</string>
    <string name="action_open_accessibility_settings_change">Change remote control setting</string>
    <string name="main_privacy_note">While sharing, an ongoing notification stays visible on the shared tablet. Traffic never leaves your local network and is encrypted with a key derived from the session PIN.</string>

